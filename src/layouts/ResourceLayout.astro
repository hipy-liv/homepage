---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const { frontmatter } = Astro.props;
---
<!doctype html><html lang="en"><head><BaseHead title={`${frontmatter.title} — HiPy`} description={frontmatter.description} /></head><body><Header /><main class="resource-page"><article><a class="back-link" href="/#resources">← Back to resources</a><p class="section-label">HiPy activity</p><h1>{frontmatter.title}</h1><p class="resource-intro">{frontmatter.description}</p><div class="resource-content"><slot /></div></article></main><Footer /></body></html>
<style>
	.resource-page{min-height:70vh;padding:100px 24px}.resource-page article{max-width:850px;margin:auto}.resource-page h1{font-size:clamp(3rem,7vw,6.5rem);margin:35px 0}.back-link{font-weight:700;text-underline-offset:5px}.resource-intro{font-size:1.4rem;max-width:650px}.resource-content{border-top:2px solid var(--ink);margin-top:60px;padding-top:40px}.resource-content :global(h2){font-size:clamp(1.8rem,4vw,2.5rem);letter-spacing:-.04em;line-height:1;margin:58px 0 20px}.resource-content :global(h2:first-child){margin-top:0}.resource-content :global(h3){font-size:1.25rem;margin:0 0 8px}.resource-content :global(p),.resource-content :global(li){max-width:680px}.resource-content :global(ol),.resource-content :global(ul){padding-left:1.4rem}.resource-content :global(li){padding-left:.25rem;margin:10px 0}.resource-content :global(code){background:rgba(118,88,255,.13);padding:.1em .25em;font:.9em ui-monospace,SFMono-Regular,Menlo,monospace}.resource-content :global(pre){max-width:100%;overflow:auto;background:var(--ink);color:var(--cream);padding:22px;margin:22px 0;border-left:8px solid var(--violet);font-size:.86rem;line-height:1.55}.resource-content :global(pre code){background:transparent;padding:0;color:inherit}.resource-content :global(.activity-meta){display:flex;flex-wrap:wrap;gap:9px;margin:0 0 35px}.resource-content :global(.activity-meta span){border:1px solid var(--ink);padding:5px 9px;font-size:.76rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.resource-content :global(.time-plan){list-style:none;padding:0;margin:25px 0}.resource-content :global(.time-plan li){border-top:1px solid var(--line);padding:13px 0;margin:0}.resource-content :global(.time-plan li:last-child){border-bottom:1px solid var(--line)}.resource-content :global(.resource-callout){border:2px solid var(--ink);padding:23px;margin:32px 0;background:var(--coral)}.resource-content :global(.resource-callout.build-next){background:var(--lime);box-shadow:7px 7px 0 var(--ink)}.resource-content :global(.resource-callout.walkthrough){background:var(--violet);color:white}.resource-content :global(.resource-callout p){margin-bottom:0}.resource-content :global(.resource-callout.build-next pre){margin-bottom:20px}.resource-content :global(.video-embed){position:relative;aspect-ratio:16/9;margin-top:18px}.resource-content :global(.video-embed iframe){position:absolute;width:100%;height:100%;border:0;inset:0}.resource-content :global(details){border-top:2px solid var(--ink);border-bottom:2px solid var(--ink);padding:16px 0;margin:32px 0}.resource-content :global(summary){cursor:pointer;font-weight:700}.resource-content :global(details[open] summary){margin-bottom:13px}@media(max-width:560px){.resource-page{padding:70px 18px}.resource-page h1{margin:28px 0}.resource-intro{font-size:1.2rem}.resource-content{margin-top:38px;padding-top:28px}.resource-content :global(pre){margin-left:0;margin-right:0;padding:16px;font-size:.75rem}}
</style>
