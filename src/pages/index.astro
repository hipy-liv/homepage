---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---
<!doctype html>
<html lang="en">
	<head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} /></head>
	<body>
		<Header />
		<main>
			<section class="hero section-shell" id="home">
				<div class="hero-copy">
					<p class="eyebrow"><span></span> Liverpool's friendliest coding community</p>
					<h1>Come curious.<br /><em>Leave coding.</em></h1>
					<p class="hero-lead">HiPy is a grassroots community where anyone can learn to code, build useful things, and meet good people. No experience, tech degree, or serious face required.</p>
					<div class="hero-actions"><a class="button button-primary" href="#events">Find an event <span aria-hidden="true">↘</span></a><a class="text-link" href="#about">Meet HiPy <span aria-hidden="true">→</span></a></div>
				</div>
				<div class="code-window" aria-label="A friendly Python code example">
					<div class="window-bar"><span></span><span></span><span></span><small>hello_hipy.py</small></div>
					<pre><code><i>def</i> <b>learn_together</b>(people):
    <i>for</i> person <i>in</i> people:
        person.try_something_new()
        person.share_what_worked()

    <i>return</i> <strong>"we've got this!"</strong>

<span>›</span> learn_together(everyone)
<strong>"we've got this!"</strong></code></pre>
					<div class="sticker sticker-one">100%<br/>beginner<br/>friendly</div><div class="sticker sticker-two">⌁</div>
				</div>
			</section>
			<section class="ticker" aria-label="HiPy values"><div class="ticker-track"><span>LEARN BY DOING <b>✦</b> ASK ANYTHING <b>✦</b> SHARE WHAT YOU KNOW <b>✦</b> ALL ARE WELCOME <b>✦</b></span><span aria-hidden="true">LEARN BY DOING <b>✦</b> ASK ANYTHING <b>✦</b> SHARE WHAT YOU KNOW <b>✦</b> ALL ARE WELCOME <b>✦</b></span></div></section>
			<section class="about section-shell" id="about">
				<div><p class="section-label">01 — About us</p><h2>Code is better<br/>with company.</h2></div>
				<div class="about-copy"><p class="large-copy">Born at the <strong>University of Liverpool</strong>, HiPy has spent more than a decade helping people take their first—and next—steps in coding.</p><p>We bring students, staff and people from across the city together to learn side by side. Our sessions are practical, informal and collaborative: bring a laptop, a question, or simply some curiosity.</p><div class="principles"><div><b>10+</b><span>years of sharing skills</span></div><div><b>No</b><span>experience required</span></div><div><b>Free</b><span>for all, forever</span></div></div></div>
			</section>
			<section class="events" id="events"><div class="section-shell">
				<div class="section-heading"><div><p class="section-label light">02 — What's on</p><h2>Upcoming events<span>.</span></h2></div><p>Free, friendly sessions on campus.<br/>Come along and make something.</p></div>
				<div class="event-list" data-event-list aria-live="polite" aria-busy="true"><p class="empty-state">Loading upcoming events…</p></div>
			</div></section>
			<section class="resources section-shell" id="resources"><div class="section-heading"><div><p class="section-label">03 — Have a go</p><h2>Learn at your pace<span>.</span></h2></div><p>Two friendly, practical activities.<br/>No jargon. No gatekeeping.</p></div><div class="resource-grid"><a class="resource-card coral" href="/resources/personal-website-with-ai"><div class="resource-icon">&lt;/&gt;</div><p>ACTIVITY 01</p><h3>Make a personal website using AI</h3><span class="resource-arrow">↗</span><small>BEGINNER · SELF-PACED</small></a><a class="resource-card violet" href="/resources/analyse-data-with-ai"><div class="resource-icon">⌁</div><p>ACTIVITY 02</p><h3>Analyse your data using AI</h3><span class="resource-arrow">↗</span><small>BEGINNER · SELF-PACED</small></a></div></section>
			<section class="cta section-shell"><p class="section-label">You belong here</p><h2>Got curiosity?<br/><em>That's enough.</em></h2><p>Whether you've never written a line of code or you ship software every day, there's a seat for you at HiPy.</p><a class="button button-dark" href="#events">See what’s coming up <span>↘</span></a></section>
		</main><Footer />
		<script src="../scripts/events.ts"></script>
	</body>
</html>
